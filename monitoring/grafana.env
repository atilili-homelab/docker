TZ=Europe/Paris
GF_SERVER_ROOT_URL=https://grafana.macopla.com
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=grafana-db:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
GF_DATABASE_PASSWORD__FILE=/run/secrets/grafana_db_password
GF_DATABASE_SSL_MODE=disable
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/grafana_admin_password
GF_USERS_ALLOW_SIGN_UP=false
GF_DATABASE_MAX_OPEN_CONN=50
GF_DATABASE_MAX_IDLE_CONN=10
GF_DATABASE_CONN_MAX_LIFETIME=14400
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Authelia
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET__FILE=/run/secrets/grafana_oidc_client_secret
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email groups
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://sso.macopla.com/api/oidc/authorization
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://sso.macopla.com/api/oidc/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://sso.macopla.com/api/oidc/userinfo
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'admins') && 'Admin' || 'Viewer'
