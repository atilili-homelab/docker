TZ=Europe/Paris
PUID=1000
PGID=1000
APP_URL=https://wiki.macopla.com
DB_HOST=bookstack-db
DB_USERNAME=bookstack
DB_DATABASE=bookstack
FILE__DB_PASSWORD=/run/secrets/bookstack_db_password
FILE__APP_KEY=/run/secrets/bookstack_app_key
APP_DEFAULT_DARK_MODE=true

AUTH_METHOD=oidc
AUTH_AUTO_INITIATE=true
OIDC_NAME=Macopla-SSO
OIDC_DISPLAY_NAME_CLAIMS=name
OIDC_CLIENT_ID=bookstack
OIDC_ISSUER=https://sso.macopla.com
OIDC_ISSUER_DISCOVER=true
OIDC_USER_TO_GROUPS=true
OIDC_GROUPS_CLAIM=groups
OIDC_ADDITIONAL_SCOPES=groups
OIDC_REMOVE_FROM_GROUPS=true
FILE__OIDC_CLIENT_SECRET=/run/secrets/bookstack_oidc_client_secret
