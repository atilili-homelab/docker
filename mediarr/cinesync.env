# WIKI CONFIG => https://github.com/sureshfizzy/CineSync/wiki/Configuration

###############################
### Essential Configuration ###
###############################

# Core Directories
SOURCE_DIR=/mnt/UNIFIED/FILMS-HD,/mnt/UNIFIED/FILMS-UHD,/mnt/UNIFIED/SERIES-HD,/mnt/UNIFIED/SERIES-UHD,/mnt/UNIFIED/FILMS-ANIMATION-HD,/mnt/UNIFIED/FILMS-ANIMATION-UHD,/mnt/UNIFIED/ANIMES,/mnt/UNIFIED/CONCERTS,/mnt/UNIFIED/SPECTACLES,/mnt/UNIFIED/DESSIN-ANIME,/mnt/UNIFIED/DOCUMENTAIRES-ENFANT
DESTINATION_DIR=/mnt/SYMLINKS
# TMDB_API_KEY=

# Web Interface Configuration
CINESYNC_IP=0.0.0.0
CINESYNC_PORT=8082
CINESYNC_AUTH_ENABLED=false
# CINESYNC_USERNAME
# CINESYNC_PASSWORD

# Loging Configuration
LOG_LEVEL=INFO

########################################
### Media Organization Configuration ###
########################################

# Layout Options
CINESYNC_LAYOUT=false
USE_SOURCE_STRUCTURE=true
SHOW_RESOLUTION_STRUCTURE=false
MOVIE_RESOLUTION_STRUCTURE=false

# Content Separation
ANIME_SEPARATION=false
4K_SEPARATION=false
KIDS_SEPARATION=false

# Custom Folder Names
# CUSTOM_MOVIE_FOLDER
# CUSTOM_SHOW_FOLDER
# CUSTOM_ANIME_MOVIE_FOLDER
# CUSTOM_ANIME_SHOW_FOLDER

# File Processing
RENAME_ENABLED=true
# RENAME_TAGS=
ALLOWED_EXTENSIONS=.mp4,.mkv,.srt,.avi,.mov,.divx,.strm,.m4v
SKIP_ADULT_PATTERNS=true
SKIP_EXTRAS_FOLDER=true
REPLACE_ILLEGAL_CHARACTERS=true
COLON_REPLACEMENT=Delete
SYMLINK_DELETE_BEHAVIOUR=trash

# Performance Settings
MAX_PROCESSES=8
SLEEP_TIME=60
SYMLINK_CLEANUP_INTERVAL=172800

############################
### Metadata & DB Config ###
############################

# Metadata sources
TMDB_FOLDER_ID=true
IMDB_FOLDER_ID=true
TVDB_FOLDER_ID=true
ANIME_SCAN=true
LANGUAGE=French

# Collection Management
MOVIE_COLLECTION_ENABLED=false
RELATIVE_SYMLINK=false

# Database Configuration
DB_THROTTLE_RATE=50.0
DB_MAX_RETRIES=10
DB_RETRY_DELAY=1.0
DB_BATCH_SIZE=2000
DB_MAX_WORKERS=8

################################
### Media Server Integration ###
################################

# Plex Config
ENABLE_PLEX_UPDATE=false
# PLEX_URL=
# PLEX_TOKEN=

# Remote Storage
RCLONE_MOUNT=false
# MOUNT_CHECK_INTERVAL=30

###################################
### WebDAV Server Configuration ###
###################################


# File Renaming
JELLYFIN_ID_FORMAT=true
MEDIAINFO_PARSER=true
MEDIAINFO_RADARR_TAGS={Movie TitleYear} - {Quality Title}
MEDIAINFO_SONARR_SEASON_FOLDER_FORMAT=Season{season:00}
MEDIAINFO_SONARR_STANDARD_EPISODE_FORMAT={Series TitleYear}S{season:00}E{episode:00} - {Episode Title} - {Quality Title}
MEDIAINFO_SONARR_ANIME_EPISODE_FORMAT={Series TitleYear}S{season:00}E{episode:00} - {Episode Title} - {Quality Title}
MEDIAINFO_SONARR_DAILY_EPISODE_FORMAT={Series TitleYear} {Air-Date} - {Episode Title} - {Quality Title}
SKIP_VERSIONS=true

# Extra
SHOW_EXTRAS_SIZE_LIMIT=5
MOVIE_EXTRAS_SIZE_LIMIT=20

# Mediahub config
MEDIAHUB_AUTO_START=true
RTM_AUTO_START=false
FILE_OPERATIONS_AUTO_MODE=true
