KOMODO_HOST=https://komodo.macopla.com
KOMODO_DISABLE_CONFIRM_DIALOG=true
KOMODO_PRIVATE_KEY_FILE=/run/secrets/komodo_private_key
KOMODO_DISABLE_INIT_RESOURCES=true

# Valeur par défaut gardée exprès : les nouveaux comptes OIDC arrivent désactivés, en attente de validation admin
KOMODO_DISABLE_USER_REGISTRATION=false
KOMODO_DISABLE_NON_ADMIN_CREATE=true

KOMODO_OIDC_ENABLED=true
KOMODO_OIDC_PROVIDER=https://sso.macopla.com
KOMODO_OIDC_CLIENT_ID=komodo
KOMODO_OIDC_CLIENT_SECRET_FILE=/run/secrets/komodo_oidc_client_secret

KOMODO_CORS_ALLOWED_ORIGINS=https://komodo.macopla.com

KOMODO_DATABASE_ADDRESS=mongo:27017
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD_FILE=/run/secrets/komodo_db_password

KOMODO_WEBHOOK_SECRET_FILE=/run/secrets/komodo_webhook_secret
