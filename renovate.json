{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>homelab/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Immich : server et ML toujours ensemble",
      "matchPackageNames": [
        "altran1502/immich-*"
      ],
      "groupName": "immich"
    },
    {
      "description": "qBittorent : ignorer les vieux tags 14.x et 20.x restés sur Docker Hub",
      "matchPackageNames": [
        "linuxserver/qbittorrent"
      ],
      "allowedVersions": "<10"
    }
  ]
}
