FORGEJO__server__DOMAIN=forge.macopla.com
FORGEJO__server__ROOT_URL=https://forge.macopla.com/
FORGEJO__server__SSH_DOMAIN=forge.macopla.com
FORGEJO__server__SSH_PORT=2222

FORGEJO__service__DISABLE_REGISTRATION=false
FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION=true
FORGEJO__service__ENABLE_INTERNAL_SIGNIN=false
FORGEJO__service__ENABLE_BASI_AUTHENTICATION=false

FORGEJO__repository__ENABLE_PUSH_CREATE_ORG=true
FORGEJO__repository__DEFAULT_PUSH_CREATE_PRIVATE=true
FORGEJO__repository_0X2E_signing__FORMAT=ssh
FORGEJO__repository_0X2E_signing__SIGNING_KEY=/var/lib/gitea/ssh/forgejo_sign.pub
FORGEJO__repository_0X2E_signing__SIGNING_NAME=MacoplaForge
FORGEJO__repository_0X2E_signing__SIGNING_EMAIL=forge@macopla.com
FORGEJO__repository_0X2E_signing__MERGES=commitssigned

FORGEJO__webhook__ALLOWED_HOST_LIST=external,komodo.macopla.com
