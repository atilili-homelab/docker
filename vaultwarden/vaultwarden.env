# Général
TZ=Europe/Paris
DOMAIN=https://vault.macopla.com
SIGNUPS_ALLOWED=false
ADMIN_TOKEN_FILE=/run/secrets/vaultwarden_admin_token

DATABASE_URL_FILE=/run/configs/db_url

# Utilisateurs
INVITATIONS_ALLOWED=false
INVITATION_ORG_NAME=Macopla Vault
PASSWORD_HINTS_ALLOWED=false
TRASH_AUTO_DELETE_DAYS=30
# Le SSO relie les comptes par l'e-mail : seul LLDAP doit pouvoir le changer
EMAIL_CHANGE_ALLOWED=false
# Le 2FA passe par Authelia (SSO_ONLY)
_ENABLE_EMAIL_2FA=false

# Push
# Synchronisation instantanée des applications mobiles (identifiant de bitwarden.com/host)
PUSH_ENABLED=true
PUSH_INSTALLATION_ID=0e7c92fb-85a2-4b95-8880-b504001eca84
PUSH_INSTALLATION_KEY_FILE=/run/secrets/vaultwarden_push_installation_key
PUSH_RELAY_URI=https://api.bitwarden.eu
PUSH_IDENTITY_URI=https://identity.bitwarden.eu

# SMTP
SMTP_HOST=mail.macopla.com
SMTP_PORT=465
SMTP_SECURITY=force_tls
SMTP_FROM=noreply@macopla.com
SMTP_FROM_NAME=Vaultwarden
SMTP_USERNAME=noreply@macopla.com
SMTP_PASSWORD_FILE=/run/secrets/vaultwarden_smtp_password
HELO_NAME=mail.macopla.com

# SSO
SSO_ENABLED=true
SSO_AUTHORITY=https://sso.macopla.com
SSO_CLIENT_ID=vaultwarden
SSO_CLIENT_SECRET_FILE=/run/secrets/vaultwarden_oidc_client_secret
SSO_ONLY=true
SSO_SCOPES=openid email profile offline_access
# Le SSO sert seulement à se connecter : la session reste gérée par Vaultwarden,
# sinon chaque appareil est déconnecté dès que le jeton de rafraîchissement d'Authelia expire
SSO_AUTH_ONLY_NOT_SESSION=true
